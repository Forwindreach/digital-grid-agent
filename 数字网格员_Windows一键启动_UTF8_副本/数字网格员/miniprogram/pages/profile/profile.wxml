<view class="page">
  <view class="card profile-card">
    <view class="avatar">{{resident.name ? resident.name[0] : '未'}}</view>
    <view class="profile-main">
      <view class="profile-name">{{resident.name || '未登记居民'}}</view>
      <view class="profile-sub">{{resident.status === 'registered' ? resident.community + ' · ' + resident.grid : '请先完成地址登记'}}</view>
    </view>
    <button class="ghost-btn small-btn" bindtap="goRegister">{{resident.status === 'registered' ? '修改登记' : '登记'}}</button>
  </view>

  <view class="card setting-card">
    <view class="setting-row">
      <text class="setting-label">运行模式</text>
      <text class="setting-value">{{mode}}</text>
    </view>
    <view class="setting-row">
      <text class="setting-label">手机号</text>
      <text class="setting-value">{{resident.phone || '未登记'}}</text>
    </view>
  </view>

  <view class="card setting-card">
    <view class="setting-label">后端 API 地址</view>
    <input
      class="api-input"
      value="{{baseUrl}}"
      bindinput="onBaseUrlInput"
      placeholder="https://example.com"
    />
    <view class="api-actions">
      <button class="ghost-btn test-btn" bindtap="testConnection">测试连接</button>
      <button class="primary-btn save-btn" bindtap="saveBaseUrl">保存并重新登录</button>
    </view>
  </view>

  <view class="card privacy-card">
    <view class="privacy-title">个人信息使用说明</view>
    <view class="privacy-text">姓名、手机号与住址仅用于社区网格治理、诉求核实和工单流转，不会向无关第三方提供。</view>
  </view>

  <button class="ghost-btn logout-btn" bindtap="logout">退出登录</button>
</view>
