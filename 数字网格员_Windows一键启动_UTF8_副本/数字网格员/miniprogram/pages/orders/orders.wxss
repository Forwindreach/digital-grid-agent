.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 12rpx;
  color: #6b7280;
}

.filter-item.active {
  background: #0b6b4f;
  color: #ffffff;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  padding: 24rpx;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #0b6b4f;
  font-weight: 600;
}

.order-title {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.order-detail-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #374151;
  font-size: 24rpx;
}

.order-meta {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
}
