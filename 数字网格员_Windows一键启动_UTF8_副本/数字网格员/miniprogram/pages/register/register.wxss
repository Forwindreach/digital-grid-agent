.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.form-card {
  margin-top: 8rpx;
}

.field-label {
  margin: 24rpx 0 12rpx;
  color: #374151;
  font-size: 26rpx;
}

.field-label:first-child {
  margin-top: 0;
}

.field-input,
.picker-value {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #f4f6f5;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.picker-value {
  color: #1f2937;
}

.consent-group {
  display: block;
  margin-top: 32rpx;
}

.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.6;
}

.consent-row checkbox {
  transform: scale(0.8);
  margin-top: 4rpx;
}

.submit-btn {
  position: relative;
  z-index: 10;
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
}

.submit-btn-hover {
  opacity: 0.85;
}
