page {
  background: #f4f6f5;
  color: #1f2937;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  font-size: 30rpx;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.primary-btn {
  background: #0b6b4f;
  color: #ffffff;
  border-radius: 14rpx;
}

.primary-btn::after {
  border: none;
}

.ghost-btn {
  background: #eef2f0;
  color: #1f2937;
  border-radius: 14rpx;
}

.ghost-btn::after {
  border: none;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef2f0;
  color: #0b6b4f;
}

.tag-warn {
  background: #fff7e6;
  color: #a16207;
}

.tag-archived {
  background: #eef2ff;
  color: #3730a3;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #9ca3af;
}
